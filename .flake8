[flake8]
# Match the wider Rapid7 connectors convention: 120, not 79, per line.
max-line-length = 120

# Unused imports in __init__.py are deliberate; they are the public interface.
per-file-ignores = __init__.py:F401

extend-ignore =
    # Defer line-wrapping style to black.
    E203,
    W503

exclude =
    .git,
    __pycache__,
    build,
    dist,
    .venv,
    venv,
    env,
    .pytest_cache,
    .hypothesis,
    node_modules
